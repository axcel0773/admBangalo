# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# URL pública do app (usada no link mágico de login)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notificações push (opcional; só no servidor, nunca com NEXT_PUBLIC_) ---
# Passo a passo em docs/notificacoes.md. Gere o par com: node scripts/gerar-vapid.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com
# Segredo do cron diário (16+ caracteres); o mesmo texto vira hash na tabela push_cron_secret.
# CRON_SECRET=
